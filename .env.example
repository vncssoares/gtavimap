# ==============================================================================
# GTAVIMap - Environment Configuration
# ==============================================================================

# Contact & DMCA Takedown requests email
# Rendered dynamically on /[lang]/contact and in mailto links
NEXT_PUBLIC_CONTACT_EMAIL="contact@gtavimap.com"

# Analytics / Measurement Provider Script (Optional)
# No script will ever be downloaded or injected into the browser without user consent
# Example: https://plausible.io/js/script.js or https://analytics.example.com/script.js
NEXT_PUBLIC_ANALYTICS_SRC=""

# Analytics Site / Website ID (Optional)
NEXT_PUBLIC_ANALYTICS_ID=""

# Search Engine Indexing Gate
# Leave unset or set to 'on' for normal indexing.
# Set to 'off' in preview/staging environments to force noindex, nofollow and empty sitemap.
SITE_INDEXING="on"

# Marker Data Mode
# "demo" (default in development) - Uses the demo marker dataset (src/data/markers.demo.ts)
# "verified" (default in production) - Uses verified in-game markers (src/data/verified/markers.json)
# "both" (dev only) - Combines demo and verified markers for local testing
DATA_MODE="demo"

# Dev Tools (Coordinate Capture Tool on map)
# Set to "on" to force-enable coordinate capture tool even if NODE_ENV !== 'production'
# Never enabled or bundled in production builds
NEXT_PUBLIC_DEV_TOOLS="off"

